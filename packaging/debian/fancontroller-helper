#!/usr/bin/python3 -I
"""Fixed Polkit entry point for one command or a private control session."""
import json
import os
import sys

sys.dont_write_bytecode = True


def main():
    try:
        if os.geteuid() != 0:
            raise PermissionError("请通过 pkexec 运行硬件设置助手")
        session = sys.argv[1:] == ["--session"]
        if not session and len(sys.argv) != 3:
            raise ValueError("用法：fancontroller-helper CONTROL VALUE 或 --session")
        sys.path.insert(0, "/usr/lib/fancontroller")
        from fancontroller.backend import Backend

        if session:
            from fancontroller.control_server import serve

            return serve(Backend(), sys.stdin.buffer, sys.stdout)
        result = Backend().set_control(sys.argv[1], sys.argv[2])
        print(json.dumps({"success": True, "result": result}, ensure_ascii=False))
        return 0
    except Exception as error:
        print(json.dumps({"success": False, "error": str(error)}, ensure_ascii=False))
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
