<Window x:Class="FanController.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:FanController"
        xmlns:ctrl="clr-namespace:FanController.Controls"
        Title="FanController — 小新风扇控制与硬件监控"
        Icon="app.ico"
        Height="780" Width="1180" MinHeight="720" MinWidth="1040"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">
    <DockPanel>
        <!-- 顶部状态栏 -->
        <Border DockPanel.Dock="Top" Padding="18,12,18,8" Background="#FF1B1B20">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                    <TextBlock Text="FanController" FontSize="17" FontWeight="Bold"
                               Foreground="{StaticResource AccentBrush}"/>
                    <TextBlock Text="小新 Air 14 (R5 4600U)" FontSize="12" Margin="10,3,0,0"
                               Foreground="{StaticResource FgDimBrush}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Border x:Name="ChipAdmin" Style="{StaticResource ChipStyle}" Margin="0,0,8,0">
                        <TextBlock x:Name="ChipAdminText" Text="管理员：检查中" FontSize="11"/>
                    </Border>
                    <Border x:Name="ChipDriver" Style="{StaticResource ChipStyle}" Margin="0,0,8,0">
                        <TextBlock x:Name="ChipDriverText" Text="监控驱动：检查中" FontSize="11"/>
                    </Border>
                    <Border x:Name="ChipEc" Style="{StaticResource ChipStyle}" Margin="0,0,8,0">
                        <TextBlock x:Name="ChipEcText" Text="EC：检查中" FontSize="11"/>
                    </Border>
                    <Border x:Name="ChipEnergy" Style="{StaticResource ChipStyle}" Margin="0,0,8,0">
                        <TextBlock x:Name="ChipEnergyText" Text="EnergyDrv：检查中" FontSize="11"/>
                    </Border>
                    <Border x:Name="ChipFanMode" Style="{StaticResource ChipStyle}">
                        <TextBlock x:Name="ChipFanModeText" Text="风扇：EC 自动" FontSize="11"/>
                    </Border>
                </StackPanel>
            </DockPanel>
        </Border>

        <TabControl x:Name="MainTabs" Margin="8,4,8,8">

            <!-- ============ 仪表盘 ============ -->
            <TabItem Header="仪表盘">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="10,6">
                    <StackPanel x:Name="DashboardRows" MaxWidth="1400" HorizontalAlignment="Stretch"/>
                </ScrollViewer>
            </TabItem>

            <!-- ============ 散热与除尘 ============ -->
            <TabItem Header="散热与除尘">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="10">
                        <Border Style="{StaticResource CardPanel}" Margin="4,8" Padding="16">
                            <StackPanel>
                                <TextBlock Text="Fn+Q 散热模式" FontSize="15" FontWeight="Bold"/>
                                <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" Foreground="{StaticResource FgDimBrush}"
                                           Text="切换联想的系统散热与功耗策略，等同于 Fn+Q 的模式选择。风扇仍由固件自动调节。"/>
                                <Grid Margin="0,16,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Button x:Name="BtnProfileSaving" Grid.Column="0" Content="节能" Click="BtnProfileSaving_Click" Margin="0,0,10,0" MinHeight="42" IsEnabled="False"/>
                                    <Button x:Name="BtnProfileIntelligent" Grid.Column="1" Content="智能散热" Click="BtnProfileIntelligent_Click" Margin="0,0,10,0" MinHeight="42" IsEnabled="False"/>
                                    <Button x:Name="BtnProfilePerformance" Grid.Column="2" Content="性能" Click="BtnProfilePerformance_Click" MinHeight="42" IsEnabled="False"/>
                                </Grid>
                                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                    <Button Content="读取当前模式" Click="BtnProfileRefresh_Click"/>
                                    <TextBlock x:Name="LblProfileCurrent" Text="当前模式：读取中" Margin="14,6,0,0"/>
                                </StackPanel>
                                <TextBlock x:Name="LblProfileState" Text="正在检查本机支持的散热模式…" Margin="0,8,0,0" Foreground="{StaticResource FgDimBrush}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource CardPanel}" Margin="4,8" Padding="16">
                            <StackPanel>
                                <TextBlock Text="除尘" FontSize="15" FontWeight="Bold"/>
                                <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" Foreground="{StaticResource FgDimBrush}"
                                           Text="点击一次，执行一次原生除尘；约 11 秒后结束，不循环触发。"/>
                                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                    <Button x:Name="BtnDustStart" Content="除尘一次" Click="BtnDustStart_Click" MinWidth="120"/>
                                    <Button x:Name="BtnDustStop" Content="取消本次除尘" Click="BtnDustStop_Click" MinWidth="120" Margin="10,0,0,0" IsEnabled="False"/>
                                </StackPanel>
                                <TextBlock x:Name="LblDustState" Text="除尘：未运行" Margin="0,10,0,0" TextWrapping="Wrap"/>
                                <TextBlock x:Name="LblFanState" Text="尚未执行除尘。" Margin="0,6,0,0" Foreground="{StaticResource FgDimBrush}" TextWrapping="Wrap"/>
                                <TextBlock x:Name="LblDustHint" Margin="0,8,0,0" TextWrapping="Wrap" Foreground="{StaticResource WarnBrush}" Visibility="Collapsed" Text="未检测到 EnergyDrv 驱动，除尘暂不可用。"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ============ EC 工具 ============ -->
            <TabItem Header="EC 工具">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="10">
                        <Border Style="{StaticResource CardPanel}" Margin="4,8" Padding="16">
                            <StackPanel>
                                <TextBlock Text="EC 内存视图（偏移 0x00 – 0xFF）" FontSize="15" FontWeight="Bold"/>
                                <TextBlock Margin="0,6,0,8" Foreground="{StaticResource FgDimBrush}" TextWrapping="Wrap"
                                           Text="读取 EC → 切换 Fn+Q 散热策略前后各设快照 → 对比差异，观察 EC 内部状态变化。"/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <Button Content="读取 EC" Click="BtnEcRefresh_Click" MinWidth="90"/>
                                    <Button Content="设为快照 A" Click="BtnEcSnapA_Click" Margin="8,0,0,0" MinWidth="96"/>
                                    <Button Content="设为快照 B" Click="BtnEcSnapB_Click" Margin="8,0,0,0" MinWidth="96"/>
                                    <Button Content="对比 A/B" Click="BtnEcDiff_Click" Margin="8,0,0,0" MinWidth="90"/>
                                    <TextBlock x:Name="LblEcView" Margin="14,7,0,0" Foreground="{StaticResource FgDimBrush}" Text="未读取"/>
                                </StackPanel>
                                <ItemsControl x:Name="EcDump">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Columns="16"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Width="34" Height="24" Margin="0,0,2,2"
                                                    Background="{Binding CellBrush}"
                                                    ToolTip="{Binding ToolTipText}">
                                                <TextBlock Text="{Binding Hex}" FontSize="11" FontFamily="Consolas"
                                                           Foreground="{StaticResource FgBrush}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ============ 说明 ============ -->
            <TabItem Header="说明">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="10">
                        <Border Style="{StaticResource CardPanel}" Padding="16">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="关闭按钮行为" VerticalAlignment="Center" FontSize="14"/>
                                    <ComboBox x:Name="CbCloseAction" Width="160" Margin="12,0,0,0"
                                              VerticalContentAlignment="Center" SelectionChanged="CbCloseAction_SelectionChanged">
                                        <ComboBoxItem Content="隐藏到托盘继续运行"/>
                                        <ComboBoxItem Content="直接退出程序"/>
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                    <CheckBox x:Name="ChkOverlay" Content="显示游戏内悬浮窗"
                                              VerticalAlignment="Center" FontSize="14"
                                              Checked="ChkOverlay_Changed" Unchecked="ChkOverlay_Changed"/>
                                    <TextBlock Text="位置" VerticalAlignment="Center" FontSize="14" Margin="24,0,0,0"/>
                                    <ComboBox x:Name="CbOverlayCorner" Width="100" Margin="12,0,0,0"
                                              VerticalContentAlignment="Center" SelectionChanged="CbOverlayCorner_SelectionChanged">
                                        <ComboBoxItem Content="左上"/>
                                        <ComboBoxItem Content="右上"/>
                                        <ComboBoxItem Content="左下"/>
                                        <ComboBoxItem Content="右下"/>
                                    </ComboBox>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource CardPanel}" Margin="0,8,0,0" Padding="20">
                        <StackPanel>
                            <TextBlock Text="工作原理" FontSize="16" FontWeight="Bold"/>
                            <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" Foreground="{StaticResource FgDimBrush}"
                                       Text="温度/功耗/频率来自 LibreHardwareMonitorLib（AMD SMU）；GPU 功耗/频率来自核显驱动；电池来自 WMI；散热模式对应联想 Fn+Q，除尘按次执行。"/>
                            <TextBlock Text="安全说明" FontSize="16" FontWeight="Bold" Margin="0,18,0,0"/>
                            <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" Foreground="{StaticResource FgDimBrush}"
                                       Text="1. 每次除尘约 11 秒，结束或退出程序时发送停止请求。&#x0a;2. 散热模式经回读确认后才显示切换成功，程序启动和退出不会自动更改所选模式。&#x0a;3. 风扇转速由固件调节，不提供固定 RPM 或百分比设置。"/>
                            <TextBlock Text="致谢" FontSize="16" FontWeight="Bold" Margin="0,18,0,0"/>
                            <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" Foreground="{StaticResource FgDimBrush}"
                                       Text="LibreHardwareMonitor（监控内核驱动）· Lenovo-Fan-Control（EnergyDrv 除尘模式协议）"/>
                        </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
