<UserControl x:Class="FanController.Views.DeviceCenterView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="StateBadge" TargetType="Border">
            <Setter Property="Background" Value="#FF2B2B33"/><Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="10,5"/><Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>
    <DockPanel>
    <TextBlock x:Name="OperationStatus" DockPanel.Dock="Bottom" Margin="18,6,18,10" TextWrapping="Wrap" Foreground="{StaticResource WarnBrush}" Visibility="Collapsed"/>
    <TabControl x:Name="FeatureTabs" Margin="4,6">
        <TabItem Header="电池管理">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="10">
                    <Border Style="{StaticResource CardPanel}" Padding="16" Margin="0,4,0,10">
                        <StackPanel>
                            <TextBlock Text="电池健康与续航" FontSize="16" FontWeight="Bold"/>
                            <UniformGrid Columns="4" Margin="0,18,0,14">
                                <StackPanel><TextBlock Text="当前电量" Style="{StaticResource CardTitle}"/><TextBlock x:Name="BatteryPercent" Text="-- %" Style="{StaticResource CardValue}"/></StackPanel>
                                <StackPanel><TextBlock Text="健康度" Style="{StaticResource CardTitle}"/><TextBlock x:Name="BatteryHealth" Text="-- %" Style="{StaticResource CardValue}"/></StackPanel>
                                <StackPanel><TextBlock Text="满充容量" Style="{StaticResource CardTitle}"/><TextBlock x:Name="BatteryCapacity" Text="-- Wh" Style="{StaticResource CardValue}"/></StackPanel>
                                <StackPanel><TextBlock Text="循环次数" Style="{StaticResource CardTitle}"/><TextBlock x:Name="BatteryCycles" Text="--" Style="{StaticResource CardValue}"/></StackPanel>
                            </UniformGrid>
                            <TextBlock x:Name="BatteryDetail" Text="正在读取电池信息…" Style="{StaticResource CardInfo}"/>
                            <TextBlock x:Name="BatteryAverage" Text="最近 5 分钟平均放电功率：采样中" Margin="0,8,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardPanel}" Padding="16" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="充电模式" FontSize="15" FontWeight="Bold"/>
                            <Border Background="#FF1B252C" CornerRadius="7" Padding="14,10" Margin="0,12,0,14">
                                <DockPanel>
                                    <TextBlock x:Name="ChargeCheckedAt" DockPanel.Dock="Right" Text="尚未更新" FontSize="11" Foreground="{StaticResource FgDimBrush}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                                    <StackPanel><TextBlock Text="当前生效的充电模式" Foreground="{StaticResource FgDimBrush}" FontSize="11"/>
                                        <TextBlock x:Name="ChargeCurrentValue" Text="读取中" FontSize="22" FontWeight="SemiBold" Margin="0,3,0,0"/>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                            <WrapPanel x:Name="ChargeControls">
                                <Button x:Name="ChargeNormal" Content="正常充电" Tag="Normal" Click="Charging_Click" Margin="0,0,10,6" IsEnabled="False"/>
                                <Button x:Name="ChargeConservation" Content="电池养护" Tag="Conservation" Click="Charging_Click" Margin="0,0,10,6" IsEnabled="False"/>
                                <Button x:Name="ChargeRapid" Content="快速充电" Tag="Rapid" Click="Charging_Click" Margin="0,0,10,6" IsEnabled="False"/>
                                <Button Content="刷新设备状态" Click="RefreshDevices_Click" Margin="0,0,0,6"/>
                            </WrapPanel>
                            <TextBlock x:Name="ChargeCapabilityHint" Foreground="{StaticResource WarnBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,3,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardPanel}" Padding="16">
                        <StackPanel>
                            <TextBlock Text="放电与睡眠记录" FontSize="15" FontWeight="Bold"/>
                            <TextBlock x:Name="RecordingState" Text="记录状态：读取中" FontWeight="SemiBold" Margin="0,8,0,0"/>
                            <WrapPanel Margin="0,12,0,10">
                                <CheckBox x:Name="RecordHistory" Content="记录电池历史（每 30 秒，保留 30 天）" Click="RecordHistory_Click" VerticalAlignment="Center" Margin="0,0,16,6"/>
                                <Button Content="导出历史 CSV" Click="ExportBattery_Click" Margin="0,0,0,6"/>
                            </WrapPanel>
                            <TextBlock Text="正值表示睡眠期间电量减少。" Style="{StaticResource CardInfo}" Margin="0,0,0,10"/>
                            <DataGrid x:Name="SleepHistory" IsReadOnly="True" Height="152" CanUserResizeRows="False">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="开始时间" Binding="{Binding When}" Width="115"/>
                                    <DataGridTextColumn Header="间隔" Binding="{Binding Duration}" Width="100"/>
                                    <DataGridTextColumn Header="电量减少" Binding="{Binding Drop}" Width="135"/>
                                    <DataGridTextColumn Header="能量减少" Binding="{Binding Energy}" Width="105"/>
                                    <DataGridTextColumn Header="说明" Binding="{Binding Note}" Width="*" MinWidth="170"/>
                                </DataGrid.Columns>
                            </DataGrid>
                            <TextBlock x:Name="HistoryStatus" Style="{StaticResource CardInfo}" Margin="0,10,0,0" Text="历史记录保存在应用配置目录。"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </TabItem>
        <TabItem Header="自动场景">
            <DockPanel>
                <Border DockPanel.Dock="Bottom" Background="#FF212127" BorderBrush="#FF32323A" BorderThickness="0,1,0,0" Padding="16,10">
                    <StackPanel>
                        <WrapPanel>
                            <Button Content="保存自动场景" Click="SaveAutomation_Click" Margin="0,0,10,4"/>
                            <Button Content="立即恢复自动切换" Click="ResumeAutomation_Click" Margin="0,0,0,4"/>
                        </WrapPanel>
                        <TextBlock x:Name="AutomationDraftState" Text="设置已保存" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="10">
                    <Border Style="{StaticResource CardPanel}" Padding="16" Margin="0,4,0,10">
                        <StackPanel>
                            <DockPanel>
                                <Border x:Name="AutomationStateBadge" Style="{StaticResource StateBadge}" DockPanel.Dock="Right" Margin="12,0,0,0">
                                    <TextBlock x:Name="AutomationRunState" Text="未启用" FontWeight="SemiBold"/>
                                </Border>
                                <StackPanel><TextBlock Text="当前运行状态" FontSize="12" Foreground="{StaticResource FgDimBrush}"/>
                                    <TextBlock x:Name="AutomationLiveProfile" Text="Fn+Q：读取中" FontSize="20" FontWeight="SemiBold" Margin="0,4,0,0"/>
                                </StackPanel>
                            </DockPanel>
                            <TextBlock x:Name="AutomationStatus" Text="自动场景未启用" Margin="0,10,0,0" TextWrapping="Wrap"/>
                            <TextBlock x:Name="AutomationSavedSummary" Text="正在加载已保存的规则" Style="{StaticResource CardInfo}" Margin="0,7,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardPanel}" Padding="16" Margin="0,4,0,10">
                        <StackPanel>
                            <TextBlock Text="编辑自动场景" FontSize="16" FontWeight="Bold"/>
                            <TextBlock Text="应用规则优先，应用退出后使用电源规则。" Style="{StaticResource CardInfo}" Margin="0,8,0,14"/>
                            <CheckBox x:Name="AutomationEnabled" Content="保存后启用自动场景" FontSize="14" Margin="0,0,0,14"/>
                            <CheckBox x:Name="SwitchOnPower" Content="根据插拔电源切换" Margin="0,0,0,10"/>
                            <WrapPanel>
                                <TextBlock Text="接通电源" VerticalAlignment="Center" Margin="0,0,10,8"/>
                                <ComboBox x:Name="AcProfile" Width="135" Margin="0,0,22,8" DisplayMemberPath="Name" SelectedValuePath="Value"/>
                                <TextBlock Text="使用电池" VerticalAlignment="Center" Margin="0,0,10,8"/>
                                <ComboBox x:Name="BatteryProfile" Width="135" Margin="0,0,0,8" DisplayMemberPath="Name" SelectedValuePath="Value"/>
                            </WrapPanel>
                            <WrapPanel Margin="0,10,0,0">
                                <TextBlock Text="切换间隔（秒）" VerticalAlignment="Center" Margin="0,0,10,8"/>
                                <TextBox x:Name="CooldownSeconds" Text="30" Width="65" Margin="0,0,22,8"/>
                                <TextBlock Text="手动优先（分钟）" VerticalAlignment="Center" Margin="0,0,10,8"/>
                                <TextBox x:Name="ManualPauseMinutes" Text="10" Width="65" Margin="0,0,0,8"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardPanel}" Padding="16" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="应用规则" FontSize="15" FontWeight="Bold"/>
                            <TextBlock Text="输入进程名，例如 devenv.exe 或 game.exe。多个应用同时运行时，优先使用列表中靠前的规则。" Style="{StaticResource CardInfo}" Margin="0,6,0,12"/>
                            <WrapPanel Margin="0,0,0,8">
                                <TextBox x:Name="ProcessName" Width="210" Margin="0,0,10,6" ToolTip="进程名，支持带或不带 .exe"/>
                                <ComboBox x:Name="ApplicationProfile" Width="135" Margin="0,0,10,6" DisplayMemberPath="Name" SelectedValuePath="Value"/>
                                <Button Content="添加规则" Click="AddRule_Click" Margin="0,0,10,6"/>
                                <Button Content="删除选中" Click="RemoveRule_Click" Margin="0,0,0,6"/>
                            </WrapPanel>
                            <DataGrid x:Name="ApplicationRules" IsReadOnly="True" Height="165">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="进程" Binding="{Binding ProcessName}" Width="*"/>
                                    <DataGridTextColumn Header="Fn+Q 模式" Binding="{Binding ModeName}" Width="180"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
            </DockPanel>
        </TabItem>
        <TabItem Header="设备设置">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="10">
                    <Border Style="{StaticResource CardPanel}" Padding="20" Margin="0,4,0,10">
                        <StackPanel>
                            <TextBlock Text="键盘与 USB" FontSize="16" FontWeight="Bold"/>
                            <StackPanel x:Name="DeviceControls" Margin="0,20,0,0">
                                <DockPanel Margin="0,0,0,16">
                                    <Border x:Name="FnLockBadge" Style="{StaticResource StateBadge}" DockPanel.Dock="Right" Margin="12,0,0,0"><TextBlock x:Name="FnLockState" Text="状态未知" FontSize="12"/></Border>
                                    <CheckBox x:Name="FnLock" Content="Fn 锁定（F1–F12 功能键优先）" Tag="FnLock" Click="DeviceSwitch_Click" IsThreeState="True" IsChecked="{x:Null}" IsEnabled="False" FontSize="14" VerticalAlignment="Center"/>
                                </DockPanel>
                                <DockPanel Margin="0,0,0,16">
                                    <Border x:Name="UsbAcBadge" Style="{StaticResource StateBadge}" DockPanel.Dock="Right" Margin="12,0,0,0"><TextBlock x:Name="UsbAcState" Text="状态未知" FontSize="12"/></Border>
                                    <CheckBox x:Name="UsbAc" Content="USB 持续供电（接通电源时）" Tag="UsbAc" Click="DeviceSwitch_Click" IsThreeState="True" IsChecked="{x:Null}" IsEnabled="False" FontSize="14" VerticalAlignment="Center"/>
                                </DockPanel>
                                <DockPanel Margin="0,0,0,16">
                                    <Border x:Name="UsbBatteryBadge" Style="{StaticResource StateBadge}" DockPanel.Dock="Right" Margin="12,0,0,0"><TextBlock x:Name="UsbBatteryState" Text="状态未知" FontSize="12"/></Border>
                                    <CheckBox x:Name="UsbBattery" Content="USB 持续供电（使用电池时）" Tag="UsbBattery" Click="DeviceSwitch_Click" IsThreeState="True" IsChecked="{x:Null}" IsEnabled="False" FontSize="14" VerticalAlignment="Center"/>
                                </DockPanel>
                                <DockPanel Margin="0,0,0,8">
                                    <Border x:Name="KeyboardLightBadge" Style="{StaticResource StateBadge}" DockPanel.Dock="Right" Margin="12,0,0,0"><TextBlock x:Name="KeyboardLightState" Text="状态未知" FontSize="12"/></Border>
                                    <CheckBox x:Name="KeyboardLight" Content="键盘背光" Tag="Backlight" Click="DeviceSwitch_Click" IsThreeState="True" IsChecked="{x:Null}" IsEnabled="False" FontSize="14" VerticalAlignment="Center"/>
                                </DockPanel>
                            </StackPanel>
                            <WrapPanel Margin="0,14,0,8">
                                <TextBlock Text="键盘背光闲置熄灭" VerticalAlignment="Center" Margin="0,0,12,8"/>
                                <ComboBox x:Name="BacklightTimeout" Width="150" Margin="0,0,12,8" DisplayMemberPath="Name" SelectedValuePath="Seconds"/>
                                <Button x:Name="SaveBacklight" Content="保存背光策略" Click="SaveBacklight_Click" Margin="0,0,0,8"/>
                            </WrapPanel>
                            <TextBlock x:Name="BacklightSavedState" Text="当前策略：关闭自动熄灭" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,8"/>
                            <TextBlock x:Name="BacklightDraftState" Foreground="{StaticResource WarnBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,8"/>
                            <Button Content="刷新设备状态" Click="RefreshDevices_Click" HorizontalAlignment="Left" Margin="0,20,0,0"/>
                            <TextBlock x:Name="DeviceStatus" Text="尚未读取设备设置" Margin="0,12,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </TabItem>
        <TabItem Header="功耗预设">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="10">
                    <Border Style="{StaticResource CardPanel}" Padding="20" Margin="0,4,0,10">
                        <StackPanel>
                            <TextBlock Text="Ryzen 5 4600U 功耗与温度上限" FontSize="16" FontWeight="Bold"/>
                            <DockPanel x:Name="PowerPathControls" Margin="0,16,0,0">
                                <Button DockPanel.Dock="Right" Content="选择 RyzenAdj" Click="ChooseRyzenAdj_Click" Margin="12,0,0,0"/>
                                <TextBox x:Name="RyzenAdjPath" IsReadOnly="True" ToolTip="完整解压目录中的 ryzenadj.exe"/>
                            </DockPanel>
                            <Button x:Name="ReadPower" Content="读取当前参数" Click="ReadPower_Click" HorizontalAlignment="Left" Margin="0,14,0,0"/>
                            <Border x:Name="PowerCurrentCard" Background="#FF1B252C" CornerRadius="7" Padding="14,12" Margin="0,16,0,14">
                                <StackPanel>
                                    <UniformGrid Columns="3">
                                        <StackPanel><TextBlock Text="短时功耗上限" Style="{StaticResource CardTitle}"/><TextBlock x:Name="PowerFastValue" Text="-- W" FontSize="25" FontWeight="SemiBold" Margin="0,4,0,0"/></StackPanel>
                                        <StackPanel><TextBlock Text="持续功耗上限" Style="{StaticResource CardTitle}"/><TextBlock x:Name="PowerSlowValue" Text="-- W" FontSize="25" FontWeight="SemiBold" Margin="0,4,0,0"/></StackPanel>
                                        <StackPanel><TextBlock Text="温度上限" Style="{StaticResource CardTitle}"/><TextBlock x:Name="PowerTemperatureValue" Text="-- °C" FontSize="25" FontWeight="SemiBold" Margin="0,4,0,0"/></StackPanel>
                                    </UniformGrid>
                                    <TextBlock x:Name="PowerCurrent" Text="当前限制：尚未读取" FontSize="12" Margin="0,10,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                            <UniformGrid Columns="3" x:Name="PresetControls" IsEnabled="False">
                                <Button x:Name="PresetQuiet" Tag="Quiet" Click="PowerPreset_Click" Margin="0,0,10,0" Padding="10,14"><StackPanel><TextBlock x:Name="QuietTitle" Text="安静办公" TextAlignment="Center" FontWeight="SemiBold"/><TextBlock x:Name="QuietValues" Text="15 W / 12 W / 70°C" TextAlignment="Center" TextWrapping="Wrap" Margin="0,5,0,0"/></StackPanel></Button>
                                <Button x:Name="PresetBalanced" Tag="Balanced" Click="PowerPreset_Click" Margin="0,0,10,0" Padding="10,14"><StackPanel><TextBlock x:Name="BalancedTitle" Text="均衡" TextAlignment="Center" FontWeight="SemiBold"/><TextBlock x:Name="BalancedValues" Text="25 W / 18 W / 80°C" TextAlignment="Center" TextWrapping="Wrap" Margin="0,5,0,0"/></StackPanel></Button>
                                <Button x:Name="PresetSustained" Tag="Sustained" Click="PowerPreset_Click" Padding="10,14"><StackPanel><TextBlock x:Name="SustainedTitle" Text="持续负载" TextAlignment="Center" FontWeight="SemiBold"/><TextBlock x:Name="SustainedValues" Text="30 W / 25 W / 85°C" TextAlignment="Center" TextWrapping="Wrap" Margin="0,5,0,0"/></StackPanel></Button>
                            </UniformGrid>
                            <TextBlock Style="{StaticResource CardInfo}" Margin="0,10,0,0" Text="预设目标：短时功耗 / 持续功耗 / 温度上限"/>
                            <Button x:Name="RestorePower" Content="恢复本次调整前参数" Click="RestorePower_Click" IsEnabled="False" HorizontalAlignment="Left" Margin="0,20,0,0"/>
                            <TextBlock x:Name="PowerOriginal" Text="恢复基准：首次应用预设时记录" Style="{StaticResource CardInfo}" Margin="0,8,0,0"/>
                            <TextBlock x:Name="PowerStatus" Text="点击读取参数后启用功耗预设" TextWrapping="Wrap" Margin="0,14,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </TabItem>
    </TabControl>
    </DockPanel>
</UserControl>
