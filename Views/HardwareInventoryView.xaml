<UserControl x:Class="FanController.Views.HardwareInventoryView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel Margin="14,10">
        <Border DockPanel.Dock="Top" Style="{StaticResource CardPanel}" Padding="18,14" Margin="0,0,0,12">
            <StackPanel>
                <DockPanel>
                    <WrapPanel DockPanel.Dock="Right">
                        <Button x:Name="BtnScan" Content="重新检测" Click="Scan_Click" Margin="0,0,8,0"/>
                        <Button x:Name="BtnExport" Content="导出报告" Click="Export_Click" IsEnabled="False"/>
                    </WrapPanel>
                    <StackPanel><TextBlock Text="硬件检测" FontSize="21" FontWeight="Bold"/>
                        <TextBlock x:Name="ScanStatus" Text="准备读取硬件信息" Foreground="{StaticResource FgDimBrush}" FontSize="12" Margin="0,5,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </DockPanel>
                <ProgressBar x:Name="ScanProgress" IsIndeterminate="True" Height="3" Foreground="{StaticResource AccentBrush}" Margin="0,12,0,0" Visibility="Collapsed"/>
                <UniformGrid Columns="4" Margin="0,18,0,0">
                    <StackPanel><TextBlock Text="已识别项目" Style="{StaticResource CardTitle}"/><TextBlock x:Name="DeviceCount" Text="--" FontSize="26" FontWeight="Bold"/></StackPanel>
                    <StackPanel><TextBlock Text="正常检查" Style="{StaticResource CardTitle}"/><TextBlock x:Name="NormalCount" Text="--" FontSize="26" FontWeight="Bold" Foreground="{StaticResource GoodBrush}"/></StackPanel>
                    <StackPanel><TextBlock Text="需关注" Style="{StaticResource CardTitle}"/><TextBlock x:Name="ConcernCount" Text="--" FontSize="26" FontWeight="Bold" Foreground="{StaticResource WarnBrush}"/></StackPanel>
                    <StackPanel><TextBlock Text="暂无数据" Style="{StaticResource CardTitle}"/><TextBlock x:Name="UnknownCount" Text="--" FontSize="26" FontWeight="Bold" Foreground="{StaticResource FgDimBrush}"/></StackPanel>
                </UniformGrid>
            </StackPanel>
        </Border>
        <TabControl x:Name="InventoryTabs">
            <TabItem Header="硬件信息">
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="166"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <ListBox x:Name="Categories" Background="{StaticResource CardBrush}" BorderThickness="0" Foreground="{StaticResource FgBrush}" SelectionChanged="Filter_Changed" DisplayMemberPath="Label" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="12,10"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="ItemFrame" Padding="{TemplateBinding Padding}" Background="Transparent" CornerRadius="6"><ContentPresenter/></Border>
                                    <ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="ItemFrame" Property="Background" Value="#FF2E4A5A"/></Trigger>
                                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ItemFrame" Property="Background" Value="#FF34343E"/></Trigger></ControlTemplate.Triggers>
                                </ControlTemplate></Setter.Value></Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>
                    <DockPanel Grid.Column="2">
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                            <TextBlock Text="搜索" VerticalAlignment="Center" Margin="0,0,10,0"/><TextBox x:Name="SearchText" TextChanged="Filter_Changed" ToolTip="搜索型号、厂商或硬件参数"/>
                        </DockPanel>
                        <Grid>
                            <TextBlock x:Name="EmptyMessage" Text="正在读取硬件信息…" Foreground="{StaticResource FgDimBrush}" Margin="12" TextWrapping="Wrap"/>
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <ItemsControl x:Name="DeviceItems">
                                    <ItemsControl.ItemTemplate><DataTemplate>
                                        <Border Style="{StaticResource CardPanel}" Padding="16" Margin="0,0,0,10">
                                            <StackPanel>
                                                <DockPanel Margin="0,0,0,14"><Border Background="{StaticResource ChipBrush}" CornerRadius="6" Padding="9,4" DockPanel.Dock="Right" Margin="12,0,0,0"><TextBlock Text="{Binding State}" Foreground="{Binding StateBrush}" FontSize="12"/></Border>
                                                    <StackPanel><TextBlock Text="{Binding Category}" FontSize="11" Foreground="{StaticResource FgDimBrush}" Margin="0,0,0,4"/><TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap"/></StackPanel>
                                                </DockPanel>
                                                <ItemsControl ItemsSource="{Binding Fields}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate><DataTemplate><StackPanel Margin="0,0,14,12"><TextBlock Text="{Binding Name}" Foreground="{StaticResource FgDimBrush}" FontSize="11"/><TextBlock Text="{Binding Value}" TextWrapping="Wrap" FontSize="13" Margin="0,3,0,0"/></StackPanel></DataTemplate></ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate></ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </DockPanel>
                </Grid>
            </TabItem>
            <TabItem Header="健康检查">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,10,0,0">
                    <StackPanel>
                        <ItemsControl x:Name="CheckItems"><ItemsControl.ItemTemplate><DataTemplate>
                            <Border Style="{StaticResource CardPanel}" Padding="16" Margin="0,0,0,10"><DockPanel>
                                <TextBlock Text="{Binding State}" Foreground="{Binding StateBrush}" DockPanel.Dock="Right" Margin="18,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                <StackPanel><TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding Detail}" Foreground="{StaticResource FgDimBrush}" Margin="0,5,0,0" TextWrapping="Wrap"/></StackPanel>
                            </DockPanel></Border>
                        </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                        <Expander x:Name="IssuesExpander" Header="读取情况" Foreground="{StaticResource FgDimBrush}" Margin="0,8,0,12" Visibility="Collapsed">
                            <TextBlock x:Name="IssueDetails" TextWrapping="Wrap" Foreground="{StaticResource FgDimBrush}" Margin="12"/>
                        </Expander>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </DockPanel>
</UserControl>
