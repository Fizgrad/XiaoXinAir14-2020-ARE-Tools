<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <PlatformTarget>x64</PlatformTarget>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <RootNamespace>FanController</RootNamespace>
    <AssemblyName>FanController</AssemblyName>
    <Version>1.3.0</Version>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- WinRing0 内核驱动按需释放到输出目录 -->
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- WinForms 只用于托盘 NotifyIcon；移除其隐式 using 避免 Brush/Color/Application 与 WPF 歧义 -->
    <Using Remove="System.Drawing" />
    <Using Remove="System.Windows.Forms" />
  </ItemGroup>

  <ItemGroup>
    <!-- 窗口 Icon 用 pack URI 从编译资源加载；EXE 图标由 ApplicationIcon 提供 -->
    <Resource Include="app.ico" />
    <None Update="tools\ryzenadj\*.exe;tools\ryzenadj\*.dll;tools\ryzenadj\*.sys;tools\RyzenAdj-LICENSE.txt;tools\RyzenAdj-GPL-3.0.txt;tools\ThirdPartyNotices.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- FanDiag 是独立子项目（含自己的入口），必须从本项目默认源码收集中排除 -->
  <ItemGroup>
    <Compile Remove="FanDiag\**" />
    <None Remove="FanDiag\**" />
    <Content Remove="FanDiag\**" />
    <EmbeddedResource Remove="FanDiag\**" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SystemChecks" />
    <!-- 0.9.x 需要 PawnIo 驱动但 NuGet 包不含驱动本体，传感器会全读 0；0.8.8 内嵌 WinRing0，开箱即用 -->
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.8.8" />
    <PackageReference Include="System.Management" Version="8.0.0" />
  </ItemGroup>

</Project>
